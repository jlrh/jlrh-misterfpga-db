    <switches page_id="1" page_name="Switches" base="16" default="ff,fd,f0">
        <DSW1/>
        <dip name="Coin Slot" bits="0" ids="Individual,Same"/>
        <dip name="Coin A" bits="1,3" ids="1/6,1/5,1/4,1/3,1/2,3/1,2/1,1/1"/>
        <dip name="Coin B" bits="4,6" ids="1/6,1/5,1/4,1/3,1/2,3/1,2/1,1/1"/>
